<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>local.waveterm.codex-system-theme</string>
  <key>ProgramArguments</key><array><string>__HOME__/.config/waveterm/system-theme-sync/wave-theme-sync</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__HOME__/.config/waveterm/system-theme-sync/sync.log</string>
  <key>StandardErrorPath</key><string>__HOME__/.config/waveterm/system-theme-sync/sync-error.log</string>
</dict></plist>
